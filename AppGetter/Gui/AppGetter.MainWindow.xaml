<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppGetter - Intune Win32 Package Creator"
        Height="860" Width="980"
        MinHeight="700" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12"
            BorderBrush="#D8DEE9" BorderThickness="1">
      <StackPanel>
        <TextBlock Text="AppGetter" FontSize="24" FontWeight="SemiBold" Foreground="#1B2A41"/>
        <TextBlock Text="Create Intune Win32 packages from web downloads or local installer files" Foreground="#5C6B7A" Margin="0,4,0,0"/>
        <DockPanel Margin="0,8,0,0" LastChildFill="True">
          <Button x:Name="InstallContentPrepButton"
                  Content="Install Content Prep"
                  Height="26"
                  Padding="10,2"
                  Margin="10,0,0,0"
                  DockPanel.Dock="Right"
                  VerticalAlignment="Center"
                  Visibility="Collapsed"
                  ToolTip="Install Microsoft Win32 Content Prep Tool (intunewinapputil) via winget"/>
          <TextBlock x:Name="PrereqStatusText"
                     Text="Checking prerequisites..."
                     Foreground="#5C6B7A"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center"/>
        </DockPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12"
            BorderBrush="#D8DEE9" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Application Name *" FontWeight="SemiBold" Margin="0,0,8,6"/>
        <TextBox Grid.Row="1" Grid.Column="0" x:Name="AppNameBox" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,8"
                 ToolTip="Required. Example: SIMION"/>

        <TextBlock Grid.Row="0" Grid.Column="1" Text="Publisher" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="PublisherBox" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Website URL" FontWeight="SemiBold" Margin="0,0,8,6"/>
        <TextBox Grid.Row="3" Grid.Column="0" x:Name="WebsiteUrlBox" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,8"
                 ToolTip="Page to scan for download links. Example: https://simion.com/"/>

        <TextBlock Grid.Row="2" Grid.Column="1" Text="Direct Download URL" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="DownloadUrlBox" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,8"
                 ToolTip="Optional. Skip website scanning when provided."/>

        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Text="Local Installer File" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <DockPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8" LastChildFill="True">
          <Button x:Name="BrowseInstallerButton" Content="Browse..." Width="90" Height="30" DockPanel.Dock="Right" Margin="8,0,0,0"/>
          <TextBox x:Name="InstallerPathBox" Height="30" VerticalContentAlignment="Center"
                   ToolTip="Optional. Path to an installer (.exe/.msi) already on this computer. Used instead of downloading."/>
        </DockPanel>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Developer / Support URLs (optional)" FontWeight="SemiBold" Margin="0,0,8,6"/>
        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
          <TextBox x:Name="DeveloperUrlBox" Width="300" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,0"
                   ToolTip="Developer or publisher site for logo/description lookup."/>
          <TextBox x:Name="SupportUrlBox" Width="300" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,0"
                   ToolTip="Support/docs page for silent install switch discovery."/>
          <TextBlock Text="Version:" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox x:Name="VersionBox" Width="100" Height="30" VerticalContentAlignment="Center"
                   ToolTip="Optional. Leave blank to auto-detect or use 'latest'."/>
        </StackPanel>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="Output destination" FontWeight="SemiBold" Margin="0,6,8,6" VerticalAlignment="Top"/>
        <DockPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,28,0,0" LastChildFill="True">
          <Button x:Name="BrowseOutputButton" Content="Browse..." Width="90" Height="30" DockPanel.Dock="Right" Margin="8,0,0,0"/>
          <TextBox x:Name="OutputPathBox" Height="30" VerticalContentAlignment="Center"
                   ToolTip="Base output folder. Each app gets its own subfolder."/>
        </DockPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,8,0"
              BorderBrush="#D8DEE9" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="Packaging Progress" FontWeight="SemiBold"/>
          <ProgressBar Grid.Row="1" x:Name="ProgressBar" Height="18" Margin="0,10,0,8" Minimum="0" Maximum="100"/>
          <TextBlock Grid.Row="2" x:Name="ProgressStatusText" Text="Ready." Foreground="#5C6B7A" Margin="0,0,0,8"/>

          <ListBox Grid.Row="3" x:Name="StepList" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                  <TextBlock Text="{Binding Icon}" Width="22" FontFamily="Segoe UI Symbol"/>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16"
              BorderBrush="#D8DEE9" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Icon Preview" FontWeight="SemiBold"/>
          <Border Grid.Row="1" BorderBrush="#D8DEE9" BorderThickness="1" Margin="0,10,0,10" Background="#FAFBFC">
            <Image x:Name="IconPreview" Stretch="Uniform" Margin="12"/>
          </Border>
          <TextBlock Grid.Row="2" x:Name="IconStatusText"
                     Text="Icon will appear after packaging or when a custom icon is selected."
                     TextWrapping="Wrap" Foreground="#5C6B7A" Margin="0,0,0,8"/>
          <Button Grid.Row="3" x:Name="BrowseIconButton" Content="Custom Icon..." Height="30"/>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="12" Margin="0,12,0,12"
            BorderBrush="#D8DEE9" BorderThickness="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120">
        <TextBox x:Name="LogTextBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                 TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
      </ScrollViewer>
    </Border>

    <DockPanel Grid.Row="4" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="OpenOutputButton" Content="Open Output Folder" Width="140" Height="34" Margin="0,0,8,0" IsEnabled="False"/>
        <Button x:Name="TestSandboxButton" Content="Test in Sandbox" Width="140" Height="34" Margin="0,0,8,0" IsEnabled="False"
                ToolTip="Launch Windows Sandbox and confirm install, detection, and uninstall"/>
        <Button x:Name="PackButton" Content="Create Package" Width="140" Height="34" FontWeight="SemiBold"/>
      </StackPanel>
      <TextBlock x:Name="SandboxStatusText"
                 Text="Create a package, then use Test in Sandbox to validate install, detection, and uninstall."
                 Foreground="#5C6B7A"
                 TextWrapping="Wrap"
                 VerticalAlignment="Center"
                 Margin="0,0,12,0"/>
    </DockPanel>
  </Grid>
</Window>
