<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppGetter - Intune Win32 Package Creator"
        Height="760" Width="980"
        MinHeight="640" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12"
            BorderBrush="#D8DEE9" BorderThickness="1">
      <StackPanel>
        <TextBlock Text="AppGetter" FontSize="24" FontWeight="SemiBold" Foreground="#1B2A41"/>
        <TextBlock Text="Create Intune Win32 packages from web downloads or local installers" Foreground="#5C6B7A" Margin="0,4,0,0"/>
        <DockPanel Margin="0,8,0,0" LastChildFill="True">
          <Button x:Name="InstallContentPrepButton"
                  Content="Install Content Prep"
                  Height="26"
                  Padding="10,2"
                  Margin="10,0,0,0"
                  DockPanel.Dock="Right"
                  VerticalAlignment="Center"
                  Visibility="Collapsed"
                  ToolTip="Install Microsoft Win32 Content Prep Tool (intunewinapputil) via winget"/>
          <TextBlock x:Name="PrereqStatusText"
                     Text="Checking prerequisites..."
                     Foreground="#5C6B7A"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center"/>
        </DockPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12"
            BorderBrush="#D8DEE9" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Application Name *" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBox Grid.Row="1" Grid.Column="0" x:Name="AppNameBox" Height="30" VerticalContentAlignment="Center"
                 ToolTip="Required. Example: SIMION"/>

        <TextBlock Grid.Row="0" Grid.Column="1" Text="Publisher" FontWeight="SemiBold" Margin="12,0,0,6"/>
        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="PublisherBox" Height="30" Width="220"
                 VerticalContentAlignment="Center" Margin="12,0,0,0"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Text="Installer source" FontWeight="SemiBold" Margin="0,12,0,6"/>
        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,8">
          <RadioButton x:Name="SourceUrlRadio" Content="Download URL" Margin="0,0,16,0" IsChecked="True"
                       ToolTip="Download the installer from a website or direct URL"/>
          <RadioButton x:Name="SourceLocalRadio" Content="Local installer file"
                       ToolTip="Use an installer already on this computer"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" x:Name="UrlSourcePanel">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Website URL" FontWeight="SemiBold" Margin="0,0,8,6"/>
            <TextBox Grid.Row="1" Grid.Column="0" x:Name="WebsiteUrlBox" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,0"
                     ToolTip="Page to scan for download links. Example: https://simion.com/"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Direct Download URL" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="DownloadUrlBox" Height="30" VerticalContentAlignment="Center"
                     ToolTip="Optional. Skip website scanning when provided."/>
          </Grid>
        </StackPanel>

        <DockPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" x:Name="LocalSourcePanel" Visibility="Collapsed" LastChildFill="True">
          <Button x:Name="BrowseInstallerButton" Content="Browse..." Width="90" Height="30" DockPanel.Dock="Right" Margin="8,0,0,0"/>
          <TextBox x:Name="LocalInstallerBox" Height="30" VerticalContentAlignment="Center"
                   ToolTip="Path to a local .exe, .msi, .msix, or .appx installer on this computer"/>
        </DockPanel>

        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" x:Name="SelectedSourceText"
                   Text="Provide a download URL or choose a local installer." Foreground="#5C6B7A" Margin="0,10,0,0" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Output destination" FontWeight="SemiBold" Margin="0,14,0,6"/>
        <DockPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,36,0,0" LastChildFill="True">
          <Button x:Name="BrowseOutputButton" Content="Browse..." Width="90" Height="30" DockPanel.Dock="Right" Margin="8,0,0,0"/>
          <TextBox x:Name="OutputPathBox" Height="30" VerticalContentAlignment="Center"/>
        </DockPanel>
        <StackPanel Grid.Row="6" Grid.Column="2" Orientation="Horizontal" Margin="12,36,0,0" VerticalAlignment="Top">
          <TextBlock Text="Version:" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox x:Name="VersionBox" Width="110" Height="30" VerticalContentAlignment="Center"
                   ToolTip="Optional. Leave blank to auto-detect or use 'latest'."/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,8,0"
              BorderBrush="#D8DEE9" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="Packaging Progress" FontWeight="SemiBold"/>
          <ProgressBar Grid.Row="1" x:Name="ProgressBar" Height="18" Margin="0,10,0,8" Minimum="0" Maximum="100"/>
          <TextBlock Grid.Row="2" x:Name="ProgressStatusText" Text="Ready." Foreground="#5C6B7A" Margin="0,0,0,8"/>

          <ListBox Grid.Row="3" x:Name="StepList" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                  <TextBlock Text="{Binding Icon}" Width="22" FontFamily="Segoe UI Symbol"/>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16"
              BorderBrush="#D8DEE9" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Icon Preview" FontWeight="SemiBold"/>
          <Border Grid.Row="1" BorderBrush="#D8DEE9" BorderThickness="1" Margin="0,10,0,10" Background="#FAFBFC">
            <Image x:Name="IconPreview" Stretch="Uniform" Margin="12"/>
          </Border>
          <TextBlock Grid.Row="2" x:Name="IconStatusText"
                     Text="Icon will appear after packaging or when a custom icon is selected."
                     TextWrapping="Wrap" Foreground="#5C6B7A" Margin="0,0,0,8"/>
          <Button Grid.Row="3" x:Name="BrowseIconButton" Content="Custom Icon..." Height="30"/>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="12" Margin="0,12,0,12"
            BorderBrush="#D8DEE9" BorderThickness="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120">
        <TextBox x:Name="LogTextBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                 TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="OpenOutputButton" Content="Open Output Folder" Width="140" Height="34" Margin="0,0,8,0" IsEnabled="False"/>
      <Button x:Name="PackButton" Content="Create Package" Width="140" Height="34" FontWeight="SemiBold"/>
    </StackPanel>
  </Grid>
</Window>
