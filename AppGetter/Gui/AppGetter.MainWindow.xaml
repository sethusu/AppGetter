<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppGetter - Intune Win32 Package Creator"
        Height="860" Width="980"
        MinHeight="700" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12"
            BorderBrush="#D8DEE9" BorderThickness="1">
      <StackPanel>
        <TextBlock Text="AppGetter" FontSize="24" FontWeight="SemiBold" Foreground="#1B2A41"/>
        <TextBlock Text="Create Intune Win32 packages from a download URL or a local installer file" Foreground="#5C6B7A" Margin="0,4,0,0"/>
        <DockPanel Margin="0,8,0,0" LastChildFill="True">
          <Button x:Name="InstallContentPrepButton"
                  Content="Install Content Prep"
                  Height="26"
                  Padding="10,2"
                  Margin="10,0,0,0"
                  DockPanel.Dock="Right"
                  VerticalAlignment="Center"
                  Visibility="Collapsed"
                  ToolTip="Install Microsoft Win32 Content Prep Tool (intunewinapputil) via winget"/>
          <TextBlock x:Name="PrereqStatusText"
                     Text="Checking prerequisites..."
                     Foreground="#5C6B7A"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center"/>
        </DockPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12"
            BorderBrush="#D8DEE9" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Installer source" FontWeight="SemiBold" Margin="0,0,0,6"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
          <RadioButton x:Name="DownloadUrlRadio" Content="Download URL" GroupName="AppGetterSource"
                       IsChecked="True" VerticalAlignment="Center" Margin="0,0,18,0"
                       ToolTip="Package the installer at a direct download link."/>
          <RadioButton x:Name="LocalFileRadio" Content="Local file on this computer" GroupName="AppGetterSource"
                       VerticalAlignment="Center" Margin="0,0,18,0"
                       ToolTip="Package an installer that is already saved on this machine."/>
          <RadioButton x:Name="WebsiteRadio" Content="Website (scan for links)" GroupName="AppGetterSource"
                       VerticalAlignment="Center"
                       ToolTip="Scan a product page and choose from the download links found."/>
        </StackPanel>

        <DockPanel Grid.Row="2" LastChildFill="True">
          <Button x:Name="FindLinksButton" Content="Find Links..." Width="110" Height="30"
                  DockPanel.Dock="Right" Margin="8,0,0,0"
                  ToolTip="Scan the website above and choose a download link."/>
          <Button x:Name="BrowseSourceButton" Content="Browse..." Width="90" Height="30"
                  DockPanel.Dock="Right" Margin="8,0,0,0"
                  ToolTip="Choose an installer file on this computer."/>
          <TextBox x:Name="SourceBox" Height="30" VerticalContentAlignment="Center"
                   ToolTip="Direct download URL, local installer path, or website to scan."/>
        </DockPanel>

        <TextBlock Grid.Row="3" x:Name="SelectedAppText" Text="No installer selected."
                   Foreground="#5C6B7A" Margin="0,10,0,0" TextWrapping="Wrap"/>

        <Grid Grid.Row="4" Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="130"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Application name *" FontWeight="SemiBold" Margin="0,0,8,6"/>
          <TextBox Grid.Row="1" Grid.Column="0" x:Name="AppNameBox" Height="30" Margin="0,0,8,0"
                   VerticalContentAlignment="Center" ToolTip="Required. Example: SIMION"/>

          <TextBlock Grid.Row="0" Grid.Column="1" Text="Publisher" FontWeight="SemiBold" Margin="0,0,8,6"/>
          <TextBox Grid.Row="1" Grid.Column="1" x:Name="PublisherBox" Height="30" Margin="0,0,8,0"
                   VerticalContentAlignment="Center"/>

          <TextBlock Grid.Row="0" Grid.Column="2" Text="Version" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBox Grid.Row="1" Grid.Column="2" x:Name="VersionBox" Height="30"
                   VerticalContentAlignment="Center"
                   ToolTip="Optional. Leave blank to auto-detect."/>
        </Grid>

        <TextBlock Grid.Row="5" Text="Output destination" FontWeight="SemiBold" Margin="0,14,0,6"/>
        <DockPanel Grid.Row="6" LastChildFill="True">
          <Button x:Name="BrowseOutputButton" Content="Browse..." Width="90" Height="30" DockPanel.Dock="Right" Margin="8,0,0,0"/>
          <TextBox x:Name="OutputPathBox" Height="30" VerticalContentAlignment="Center"
                   ToolTip="Base folder. Each app is packaged into its own subfolder."/>
        </DockPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,8,0"
              BorderBrush="#D8DEE9" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="Packaging Progress" FontWeight="SemiBold"/>
          <ProgressBar Grid.Row="1" x:Name="ProgressBar" Height="18" Margin="0,10,0,8" Minimum="0" Maximum="100"/>
          <TextBlock Grid.Row="2" x:Name="ProgressStatusText" Text="Ready." Foreground="#5C6B7A" Margin="0,0,0,8"/>

          <ListBox Grid.Row="3" x:Name="StepList" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                  <TextBlock Text="{Binding Icon}" Width="22" FontFamily="Segoe UI Symbol"/>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16"
              BorderBrush="#D8DEE9" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Icon Preview" FontWeight="SemiBold"/>
          <Border Grid.Row="1" BorderBrush="#D8DEE9" BorderThickness="1" Margin="0,10,0,10" Background="#FAFBFC">
            <Image x:Name="IconPreview" Stretch="Uniform" Margin="12"/>
          </Border>
          <TextBlock Grid.Row="2" x:Name="IconStatusText" Text="Icon will appear after packaging or when a custom icon is selected."
                     TextWrapping="Wrap" Foreground="#5C6B7A" Margin="0,0,0,8"/>
          <Button Grid.Row="3" x:Name="BrowseIconButton" Content="Custom Icon..." Height="30"/>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="12" Margin="0,12,0,12"
            BorderBrush="#D8DEE9" BorderThickness="1">
      <StackPanel>
        <Expander x:Name="AdvancedExpander" Header="Optional details" Margin="0,0,0,6">
          <Grid Margin="0,10,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Developer / publisher URL" Margin="0,0,8,4" Foreground="#5C6B7A"/>
            <TextBox Grid.Row="1" Grid.Column="0" x:Name="DeveloperUrlBox" Height="28" Margin="0,0,8,8"
                     VerticalContentAlignment="Center" ToolTip="Used for logo and description lookup."/>

            <TextBlock Grid.Row="0" Grid.Column="1" Text="Support / docs URL" Margin="0,0,0,4" Foreground="#5C6B7A"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="SupportUrlBox" Height="28" Margin="0,0,0,8"
                     VerticalContentAlignment="Center" ToolTip="Scanned for documented silent install switches."/>

            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Install command override" Margin="0,0,0,4" Foreground="#5C6B7A"/>
            <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="InstallCommandBox" Height="28"
                     VerticalContentAlignment="Center"
                     ToolTip="Leave blank to auto-discover the silent install switches."/>
          </Grid>
        </Expander>

        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120">
          <TextBox x:Name="LogTextBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                   TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
        </ScrollViewer>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="OpenOutputButton" Content="Open Output Folder" Width="140" Height="34" Margin="0,0,8,0" IsEnabled="False"/>
      <Button x:Name="PackButton" Content="Create Package" Width="140" Height="34" FontWeight="SemiBold"/>
    </StackPanel>
  </Grid>
</Window>
