<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppGetter - Intune Win32 Package Creator"
        Height="760" Width="980"
        MinHeight="640" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12"
            BorderBrush="#D8DEE9" BorderThickness="1">
      <StackPanel>
        <TextBlock Text="AppGetter" FontSize="24" FontWeight="SemiBold" Foreground="#1B2A41"/>
        <TextBlock Text="Create Intune Win32 packages from a download URL or a local installer" Foreground="#5C6B7A" Margin="0,4,0,0"/>
        <DockPanel Margin="0,8,0,0" LastChildFill="True">
          <Button x:Name="InstallContentPrepButton"
                  Content="Install Content Prep"
                  Height="26"
                  Padding="10,2"
                  Margin="10,0,0,0"
                  DockPanel.Dock="Right"
                  VerticalAlignment="Center"
                  Visibility="Collapsed"
                  ToolTip="Install Microsoft Win32 Content Prep Tool (intunewinapputil) via winget"/>
          <TextBlock x:Name="PrereqStatusText"
                     Text="Checking prerequisites..."
                     Foreground="#5C6B7A"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center"/>
        </DockPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12"
            BorderBrush="#D8DEE9" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Application name" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
          <TextBox x:Name="AppNameBox" Width="280" Height="30" VerticalContentAlignment="Center"
                   ToolTip="Required. Display name for Intune."/>
          <TextBlock Text="Publisher:" VerticalAlignment="Center" Margin="12,0,6,0"/>
          <TextBox x:Name="PublisherBox" Width="220" Height="30" VerticalContentAlignment="Center"
                   ToolTip="Optional publisher name."/>
        </StackPanel>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Installer source" FontWeight="SemiBold" Margin="0,12,0,6"/>
        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,6">
          <RadioButton x:Name="SourceUrlRadio" Content="Download URL" IsChecked="True" VerticalAlignment="Center"
                       ToolTip="Direct HTTP(S) URL of the installer."/>
          <RadioButton x:Name="SourceFileRadio" Content="Local installer" Margin="16,0,0,0" VerticalAlignment="Center"
                       ToolTip="An installer file already on this computer."/>
        </StackPanel>
        <DockPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" LastChildFill="True">
          <Button x:Name="BrowseInstallerButton" Content="Browse..." Width="90" Height="30" DockPanel.Dock="Right" Margin="8,0,0,0"
                  ToolTip="Choose an installer file on this computer."/>
          <TextBox x:Name="SourcePathBox" Height="30" VerticalContentAlignment="Center"
                   ToolTip="Paste a download URL or browse to a local .exe / .msi / .msix / .appx file."/>
        </DockPanel>
        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" x:Name="SelectedSourceText"
                   Text="Provide a download URL or browse to an installer on this computer."
                   Foreground="#5C6B7A" Margin="0,8,0,0" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Output destination" FontWeight="SemiBold" Margin="0,14,0,6"/>
        <DockPanel Grid.Row="6" Grid.Column="0" Margin="0,36,8,0" LastChildFill="True">
          <Button x:Name="BrowseOutputButton" Content="Browse..." Width="90" Height="30" DockPanel.Dock="Right" Margin="8,0,0,0"/>
          <TextBox x:Name="OutputPathBox" Height="30" VerticalContentAlignment="Center"/>
        </DockPanel>
        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,36,0,0" VerticalAlignment="Top">
          <TextBlock Text="Version:" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox x:Name="VersionBox" Width="110" Height="30" VerticalContentAlignment="Center"
                   ToolTip="Optional. Leave blank to auto-detect or use latest."/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,8,0"
              BorderBrush="#D8DEE9" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="Packaging Progress" FontWeight="SemiBold"/>
          <ProgressBar Grid.Row="1" x:Name="ProgressBar" Height="18" Margin="0,10,0,8" Minimum="0" Maximum="100"/>
          <TextBlock Grid.Row="2" x:Name="ProgressStatusText" Text="Ready." Foreground="#5C6B7A" Margin="0,0,0,8"/>

          <ListBox Grid.Row="3" x:Name="StepList" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                  <TextBlock Text="{Binding Icon}" Width="22" FontFamily="Segoe UI Symbol"/>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16"
              BorderBrush="#D8DEE9" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Icon Preview" FontWeight="SemiBold"/>
          <Border Grid.Row="1" BorderBrush="#D8DEE9" BorderThickness="1" Margin="0,10,0,10" Background="#FAFBFC">
            <Image x:Name="IconPreview" Stretch="Uniform" Margin="12"/>
          </Border>
          <TextBlock Grid.Row="2" x:Name="IconStatusText"
                     Text="Icon will appear after packaging or when a custom icon is selected."
                     TextWrapping="Wrap" Foreground="#5C6B7A" Margin="0,0,0,8"/>
          <Button Grid.Row="3" x:Name="BrowseIconButton" Content="Custom Icon..." Height="30"/>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="12" Margin="0,12,0,12"
            BorderBrush="#D8DEE9" BorderThickness="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120">
        <TextBox x:Name="LogTextBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                 TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="OpenOutputButton" Content="Open Output Folder" Width="140" Height="34" Margin="0,0,8,0" IsEnabled="False"/>
      <Button x:Name="PackButton" Content="Create Package" Width="140" Height="34" FontWeight="SemiBold"/>
    </StackPanel>
  </Grid>
</Window>
